rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email.lower() in [
          'teccapitalweb@gmail.com',
          'fisiotec25@gmail.com'
        ];
    }

    function own(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function activeMember() {
      let accessPath = /databases/$(database)/documents/accesos/$(request.auth.uid);
      return signedIn()
        && exists(accessPath)
        && get(accessPath).data.activa == true
        && (get(accessPath).data.get('expiraEn', null) == null
          || get(accessPath).data.get('expiraEn', null) > request.time);
    }

    function postImageOk() {
      return !('imagen' in request.resource.data)
        || request.resource.data.imagen == null
        || (request.resource.data.imagen is string
          && request.resource.data.imagen.size() < 300000);
    }

    function directoryPhotoOk() {
      return !('foto' in request.resource.data)
        || request.resource.data.foto == null
        || (request.resource.data.foto is string
          && request.resource.data.foto.size() < 250000);
    }

    function validSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'nombre', 'displayName', 'whatsapp', 'empresa', 'especialidad',
          'foto', 'lastUpdatedAt', 'notificacionPendiente'
        ])
        && (!changed.hasAny(['notificacionPendiente'])
          || (request.resource.data.get('notificacionPendiente', {}) is map
            && resource.data.get('notificacionPendiente', {}) is map
            && request.resource.data.get('notificacionPendiente', {})
              .diff(resource.data.get('notificacionPendiente', {}))
              .affectedKeys().hasOnly(['mostrada'])
            && request.resource.data.get('notificacionPendiente', {})
              .get('mostrada', false) == true));
    }

    // Precio público mostrado antes de iniciar sesión. Solo un administrador
    // puede modificar la fuente de verdad usada por Stripe.
    match /config/club {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // Los documentos contienen URLs originales de videos y materiales.
    // Los miembros reciben un catálogo saneado desde /api/cursos/catalogo.
    match /cursos/{cursoId} {
      allow read, write: if isAdmin();
    }

    // La colección global de materiales también puede contener enlaces.
    match /materiales/{materialId} {
      allow read, write: if isAdmin();
    }

    match /miembros/{uid} {
      allow read: if own(uid) || isAdmin();

      // Registro inicial: nunca puede autoactivar acceso ni sembrar campos de
      // Stripe, Ruta VIP, calendario o fechas de membresía.
      allow create: if isAdmin() || (own(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'nombre', 'displayName', 'activa', 'plan',
          'fechaRegistro', 'createdAt', 'lastUpdatedAt', 'origen'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.activa == false
        && request.resource.data.plan == null);

      // El miembro solo puede editar perfil y marcar como mostrada una
      // notificación. Todos los campos de acceso pertenecen al backend/admin.
      allow update: if isAdmin() || (own(uid) && validSelfProfileUpdate());
      allow delete: if isAdmin();

      // Fuente autoritativa del progreso. El cliente puede leer su avance,
      // pero solo Firebase Admin SDK escribe sesiones/completado.
      match /progresoCursos/{cursoId} {
        allow read: if own(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // El backend crea este documento mínimo después de validar la membresía,
    // incluso cuando el registro autoritativo histórico vive en email_....
    match /accesos/{uid} {
      allow read: if own(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Colección heredada: lectura propia para compatibilidad, sin escrituras
    // del navegador. El progreso nuevo vive bajo miembros/{uid}/progresoCursos.
    match /progreso/{uid} {
      allow read: if own(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /certificados/{folio} {
      // La verificación pública pasa por el backend, que entrega solo campos
      // públicos y exige las marcas de legitimidad. Firestore queda privado.
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      // Los certificados automáticos los crea exclusivamente Admin SDK.
      // El admin conserva emisión/eliminación manual desde vip-admin.html.
      allow create, update, delete: if isAdmin();
    }

    match /notificaciones/{notificationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /webinars/{webinarId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /noticias_auto/{newsId} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /pagos/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if activeMember() || isAdmin();
      allow create: if (activeMember() || isAdmin())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('comentariosCount', 0) == 0
        && (!('texto' in request.resource.data)
          || (request.resource.data.texto is string
            && request.resource.data.texto.size() <= 3000))
        && postImageOk();
      allow update: if (activeMember() || isAdmin()) && (
        (request.auth.uid == resource.data.uid && postImageOk())
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'likedBy', 'comentariosCount'])
      );
      allow delete: if (activeMember() || isAdmin())
        && (request.auth.uid == resource.data.uid || isAdmin());

      match /comentarios/{commentId} {
        allow read: if activeMember() || isAdmin();
        allow create: if (activeMember() || isAdmin())
          && request.resource.data.uid == request.auth.uid
          && (!('texto' in request.resource.data)
            || (request.resource.data.texto is string
              && request.resource.data.texto.size() <= 1200));
        allow update: if false;
        allow delete: if (activeMember() || isAdmin())
          && (request.auth.uid == resource.data.uid || isAdmin());
      }
    }

    match /directorio/{uid} {
      allow read: if activeMember() || isAdmin();
      allow create, update: if own(uid) && activeMember()
        && request.resource.data.uid == request.auth.uid
        && (!('nombre' in request.resource.data)
          || (request.resource.data.nombre is string
            && request.resource.data.nombre.size() < 120))
        && directoryPhotoOk();
      allow delete: if (own(uid) && activeMember()) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
